; Xbox Elite Series 2 XP Driver v1.0
; Target: Windows XP SP3 x86 / USB VID_045E PID_0B00
; Kernel binary is the validated TEST2M payload, renamed for the v1.0 package.

[Version]
Signature="$WINDOWS NT$"
Class=XB1UsbClass
ClassGuid={05F5CFE2-4733-4950-A6BB-07AAD01A3A84}
Provider=%ProviderName%
DriverVer=08/18/2026,6.2.11059.100

[ClassInstall32]
AddReg=XB1UsbClassReg

[XB1UsbClassReg]
HKR,,,0,%ClassName%
HKR,,Icon,,"-24"

[Manufacturer]
%ProviderName%=EliteXP,NTx86

[EliteXP.NTx86]
%Elite2.DeviceDesc%=XboxElite2,USB\VID_045E&PID_0B00

[XboxElite2]
CopyFiles=XboxElite2.CopyFiles
AddReg=XboxElite2.AddReg

[XboxElite2.CopyFiles]
xboxelite2xp.sys

[XboxElite2.AddReg]
HKR,,"ConfigFlags",0x00010001,1

[XboxElite2.Services]
AddService=xb1usb_elite2xp,0x00000002,XboxElite2Service

[XboxElite2Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\xboxelite2xp.sys
AddReg=XboxElite2Service.AddReg
LoadOrderGroup=Base

[XboxElite2Service.AddReg]
HKR,,"ConfigFlags",0x00010001,1

[XboxElite2.Wdf]
KmdfService=xb1usb_elite2xp,XboxElite2_WdfSect

[XboxElite2_WdfSect]
KmdfLibraryVersion=1.9

[XboxElite2.CoInstallers]
AddReg=XboxElite2_CoInstaller_AddReg
CopyFiles=XboxElite2_CoInstaller_CopyFiles

[XboxElite2_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000,"WdfCoInstaller01009.dll,WdfCoInstaller"

[XboxElite2_CoInstaller_CopyFiles]
WdfCoInstaller01009.dll

[DestinationDirs]
XboxElite2.CopyFiles=12
XboxElite2_CoInstaller_CopyFiles=11

[SourceDisksNames]
1=%DiskDescription%,,

[SourceDisksFiles]
xboxelite2xp.sys=1
WdfCoInstaller01009.dll=1

[Strings]
ProviderName="Xbox Elite Series 2 XP Project"
ClassName="Microsoft Xbox One Controller"
DiskDescription="Xbox Elite Series 2 XP Driver v1.0"
ServiceDesc="Xbox Elite Series 2 USB Driver for Windows XP"
Elite2.DeviceDesc="Xbox Elite Wireless Controller Series 2 - Windows XP"
